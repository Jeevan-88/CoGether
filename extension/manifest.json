{
  "manifest_version": 3,
  "name": "CoGether — Cinema Sync Companion",
  "version": "1.0.0",
  "description": "Synchronize play, pause, and seek timestamps across Netflix, Prime Video, Disney+, Hotstar, Crunchyroll and YouTube for CoGether watch parties.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.disneyplus.com/*",
    "*://*.hotstar.com/*",
    "*://*.crunchyroll.com/*",
    "*://*.youtube.com/*",
    "http://localhost:3001/*",
    "http://localhost:5173/*",
    "https://*.cogether.tech/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hotstar.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
