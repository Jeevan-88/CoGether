# ==============================================================================
# COGETHER DOCKER COMPOSE LOCAL CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env in this directory before running `docker compose up`.
# Never commit the populated .env file to version control.
# ==============================================================================

POSTGRES_USER=cogether_user
POSTGRES_PASSWORD=your_secure_dev_password_here
POSTGRES_DB=cogether_db

DATABASE_URL=postgresql://cogether_user:your_secure_dev_password_here@cogether-db:5432/cogether_db
REDIS_URL=redis://cogether-redis:6379

JWT_SECRET=your_jwt_secret_min_32_characters_random_key_here
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
PORT=3001
