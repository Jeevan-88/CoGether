# ==============================================================================
# COGETHER PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure values before starting in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development                     # 'development' | 'production' | 'test'
PORT=3001                                # Backend API & Socket.IO port
HOST=0.0.0.0                             # Server binding host
CLIENT_URL=http://localhost:5173         # Frontend origin for redirects & links
CORS_ORIGIN=http://localhost:5173        # Allowed CORS origin (production: e.g. https://cogether.app)

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL - Authoritative Store)
# ------------------------------------------------------------------------------
# In production, this must point to a hardened, dedicated PostgreSQL 15+ cluster.
# Fail-closed: The server will terminate immediately on startup if PostgreSQL is unavailable.
DATABASE_URL=postgresql://your_db_user:your_db_password@127.0.0.1:5432/your_db_name
DATABASE_SSL=false                       # Set to 'true' for production managed databases (Supabase, Neon, RDS)
DATABASE_POOL_MAX=20                     # Maximum connections in connection pool
DATABASE_IDLE_TIMEOUT_MS=30000           # Connection idle timeout in milliseconds

# ------------------------------------------------------------------------------
# 3. EPHEMERAL PRESENCE & CACHE (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379         # Redis instance for room presence and locks
REDIS_ENABLED=true                       # Set to 'false' to disable distributed Redis presence

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# In production, JWT_SECRET must be a cryptographically strong key (minimum 32 bytes).
# Fail-closed: The server refuses to start in production without a valid JWT_SECRET.
JWT_SECRET=your_jwt_secret_min_32_chars_random_string_here
JWT_EXPIRES_IN=15m                       # Access token lifespan (e.g. '15m', '1h')
JWT_EXPIRES_IN_SECONDS=900               # Access token lifespan in seconds
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800  # Refresh token lifespan in seconds (7 days)
COOKIE_SECRET=your_cookie_secret_min_32_chars_random_string_here
OTP_SALT=your_otp_salt_random_string_placeholder
OTP_EXPIRES_IN_SECONDS=600               # OTP lifetime in seconds (10 minutes)
OTP_MAX_ATTEMPTS=5                       # Maximum failed verification attempts before lockout
OTP_RESEND_INTERVAL_SECONDS=60           # Minimum cooldown before new OTP can be requested

# ------------------------------------------------------------------------------
# 5. EMAIL DELIVERY (Resend / SMTP)
# ------------------------------------------------------------------------------
# Provider options: 'resend' | 'smtp' | 'console_test' (development only)
# In production, EMAIL_PROVIDER must be 'resend' or 'smtp'. If missing, login requests fail closed.
EMAIL_PROVIDER=console_test
FROM_EMAIL=auth@cogether.app

# Option A: Resend API
RESEND_API_KEY=re_your_resend_api_key_placeholder

# Option B: Standard SMTP (SendGrid, Postmark, AWS SES, Mailgun)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_password_placeholder

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 / OIDC AUTHENTICATION
# ------------------------------------------------------------------------------
# Register OAuth credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 7. AVATAR & ASSET STORAGE ABSTRACTION (S3 / Local Fallback)
# ------------------------------------------------------------------------------
# Provider options: 's3' (AWS S3, Cloudflare R2, Supabase Storage, MinIO) | 'local'
# Strict MIME validation: image/jpeg, image/png, image/webp, image/gif. Max size: 5MB.
STORAGE_PROVIDER=local
S3_BUCKET=cogether-avatars
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_PUBLIC_URL_BASE=https://cogether-avatars.s3.amazonaws.com

# ------------------------------------------------------------------------------
# 8. INVITE POLICIES
# ------------------------------------------------------------------------------
INVITE_DEFAULT_MAX_USES=10               # Default number of allowed redemptions per invite
INVITE_DEFAULT_EXPIRES_HOURS=48          # Default invite expiration lifetime (hours)
INVITE_MAX_ALLOWED_USES=100              # Hard ceiling for maximum invite redemptions

# ------------------------------------------------------------------------------
# 9. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
SERVICE_NAME=cogether-platform
LOG_LEVEL=info                           # 'debug' | 'info' | 'warn' | 'error'
